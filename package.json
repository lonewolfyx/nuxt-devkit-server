{
    "name": "nuxt-devkit-server",
    "type": "module",
    "version": "0.0.0",
    "packageManager": "pnpm@10.33.2",
    "description": "Create a local server for running Nuxt outputs in CLI tools.",
    "author": "lonewolfyx",
    "license": "MIT",
    "homepage": "https://github.com/lonewolfyx/nuxt-devkit-server",
    "bugs": {
        "url": "https://github.com/lonewolfyx/nuxt-devkit-server/issues"
    },
    "keywords": [
        "nuxt"
    ],
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.mjs"
        }
    },
    "main": "./dist/index.mjs",
    "types": "./dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "dev": "tsdown --watch",
        "build": "tsdown",
        "test": "vitest run",
        "test:watch": "vitest",
        "lint": "eslint .",
        "lint:fix": "eslint --fix",
        "prepare": "simple-git-hooks",
        "prepublishOnly": "pnpm build"
    },
    "publishConfig": {
        "registry": "https://registry.npmjs.org",
        "access": "public"
    },
    "peerDependencies": {
        "crossws": ">=0.4"
    },
    "peerDependenciesMeta": {
        "crossws": {
            "optional": true
        }
    },
    "dependencies": {
        "get-port-please": "^3.2.0"
    },
    "devDependencies": {
        "@antfu/eslint-config": "^9.0.0",
        "@lonewolfyx/tsconfig": "^0.0.6",
        "@types/node": "^25.9.1",
        "crossws": "^0.4.5",
        "eslint": "^10.4.0",
        "jiti": "^2.7.0",
        "nano-staged": "^1.0.2",
        "picocolors": "^1.1.1",
        "simple-git-hooks": "^2.13.1",
        "tsdown": "^0.22.0",
        "tsx": "^4.22.3",
        "typescript": "^6.0.3",
        "vitest": "^4.1.7"
    },
    "simple-git-hooks": {
        "pre-commit": "npx nano-staged",
        "commit-msg": "node scripts/verify-commit.js"
    },
    "nano-staged": {
        "*": "eslint --fix"
    }
}
